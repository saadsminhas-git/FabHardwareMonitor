<views:FabWindow x:Class="FabHardwareMonitor.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:views="clr-namespace:FabHardwareMonitor.Views"
                 Style="{StaticResource FabWindow}"
                 Title="About"
                 Width="452"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen">

    <StackPanel Margin="28,26,28,22">

        <!-- Identity -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Source="/Assets/app-icon.png"
                   Width="44"
                   Height="44"
                   VerticalAlignment="Top"
                   Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ProductName}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Style="{StaticResource EyebrowText}" Margin="0,5,0,0">
                    <Run Text="VERSION" />
                    <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Rule}" Margin="0,22,0,0" />

        <!-- Updates -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2,0,0,0"
                Padding="16,14"
                Margin="0,22,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="UPDATES" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding Updates.Message}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Install update"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding InstallCommand}"
                            Visibility="{Binding Updates.ShowInstallButton, Converter={StaticResource BoolVis}}" />
                    <Button Content="Check now"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CheckCommand}"
                            Visibility="{Binding Updates.ShowCheckButton, Converter={StaticResource BoolVis}}" />
                    <Button Content="Try again"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding CheckCommand}"
                            Visibility="{Binding Updates.ShowRetryButton, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Rule}" Margin="0,22,0,0" />

        <!-- Credits -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="AUTHOR" Style="{StaticResource EyebrowText}" Margin="0,2,0,0" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding Author}"
                       FontSize="13"
                       Foreground="{DynamicResource TextBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="SOURCE" Style="{StaticResource EyebrowText}" Margin="0,20,0,0" />
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource LinkButton}"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Left"
                    Content="{Binding RepoLabel}"
                    ToolTip="{Binding RepoUrl}"
                    AutomationProperties.Name="Open the GitHub repository"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding RepoUrl}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="INSPIRED BY" Style="{StaticResource EyebrowText}" Margin="0,20,0,0" />
            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource LinkButton}"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Left"
                    Content="{Binding InspiredBy}"
                    ToolTip="{Binding InspiredByUrl}"
                    AutomationProperties.Name="Open Traffic Monitor by zhongyang219"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding InspiredByUrl}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="PRIVACY" Style="{StaticResource EyebrowText}" Margin="0,20,0,0" />
            <Button Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource LinkButton}"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Left"
                    Content="Privacy &amp; terms"
                    AutomationProperties.Name="Open the privacy policy and terms of use"
                    Click="OnPrivacy" />
        </Grid>

        <Border Style="{StaticResource Rule}" Margin="0,24,0,0" />

        <!-- Brand lockup: official Fabric Visuals mark, centred, links to the site. -->
        <Button Style="{StaticResource LinkButton}"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                ToolTip="{Binding WebsiteUrl}"
                AutomationProperties.Name="Open the Fabric Visuals website"
                Command="{Binding OpenUrlCommand}"
                CommandParameter="{Binding WebsiteUrl}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/fabric-visuals-mark.png"
                       Width="15"
                       Height="15"
                       VerticalAlignment="Center"
                       Margin="0,0,9,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" />
                <TextBlock Text="{Binding Company, Converter={StaticResource Tracked}}"
                           FontFamily="{StaticResource SansFont}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </StackPanel>
</views:FabWindow>
