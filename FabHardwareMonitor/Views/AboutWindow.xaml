<Window x:Class="FabHardwareMonitor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF121417"
        Foreground="#FFF4F1EA"
        FontFamily="Bahnschrift"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFC4A574" />
            <Setter Property="Foreground" Value="#FF121417" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFC4A574" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#33C4A574" BorderThickness="0,3,0,0" Padding="28,24,28,28">
        <StackPanel>
            <Image Source="/Assets/fabric-visuals-logo.png"
                   Height="48"
                   Stretch="Uniform"
                   Cursor="Hand"
                   MouseLeftButtonUp="OnLogoClick"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding ProductName}"
                       FontSize="20"
                       FontWeight="Light"
                       Margin="0,18,0,4"
                       HorizontalAlignment="Center" />
            <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="#FFC8C4BB">
                <Run Text="Version" />
                <Run Text="{Binding Version, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Updates.Message}"
                       Margin="0,12,0,8"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#FFC4A574" />
            <Button Content="Install update"
                    Command="{Binding InstallCommand}"
                    Visibility="{Binding Updates.ShowInstallButton, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,6" />
            <Button Content="Check for updates"
                    Style="{StaticResource Ghost}"
                    Command="{Binding CheckCommand}"
                    Visibility="{Binding Updates.ShowCheckButton, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Center" />
            <Button Content="Try again"
                    Style="{StaticResource Ghost}"
                    Command="{Binding CheckCommand}"
                    Visibility="{Binding Updates.ShowRetryButton, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Author}"
                       Margin="0,20,0,10"
                       HorizontalAlignment="Center"
                       FontSize="14" />
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,6">
                <Hyperlink NavigateUri="{Binding RepoUrl}" RequestNavigate="OnLink" Foreground="#FFC4A574">
                    <Run Text="{Binding RepoUrl, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink NavigateUri="{Binding WebsiteUrl}" RequestNavigate="OnLink" Foreground="#FFC4A574">
                    <Run Text="{Binding WebsiteLabel, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
