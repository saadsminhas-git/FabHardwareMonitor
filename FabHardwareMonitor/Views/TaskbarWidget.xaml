<Window x:Class="FabHardwareMonitor.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fab Hardware Monitor"
        Width="336"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{Binding LabelBrush}" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <!--
        Deskband11Lib's WPF sample is AllowsTransparency + attach, then Show.
        First paint then happens after the window is already a sized taskbar
        child. A 1-alpha fill keeps right-clicks on the widget, not the taskbar.
        The plate is 32px on a 48px deskband so the inset matches the search pill.
    -->
    <Grid Background="#01000000">
        <Border Height="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Background="{Binding PlateBrush}"
                CornerRadius="8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{Binding RailBrush}"
                        CornerRadius="8,0,0,8" />
                <Grid Grid.Column="1" Margin="10,2,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="↑" Foreground="{Binding UploadBrush}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding UploadText}" Foreground="{Binding UploadBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="↓" Foreground="{Binding DownloadBrush}" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding DownloadText}" Foreground="{Binding DownloadBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="CPU" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="MEM" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding MemText}" Foreground="{Binding MemBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="GPU" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding GpuText}" Foreground="{Binding GpuBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="VRAM" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding VramText}" Foreground="{Binding VramBrush}" />
                    </StackPanel>

                    <Button Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            Width="16"
                            Height="16"
                            Margin="0,0,2,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="CPU temperature needs PawnIO. Click for Settings."
                            Click="OnPawnIoWarningClick"
                            Visibility="{Binding ShowPawnIoWarning, Converter={StaticResource BoolVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Width="16" Height="16">
                                    <Ellipse Fill="#E6A21A" />
                                    <TextBlock Text="!"
                                               Foreground="White"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-1,0,0" />
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="CPU" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Label}" Text="GPU" />
                        <TextBlock Style="{StaticResource Value}" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
