<Window x:Class="FabHardwareMonitor.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fab Hardware Monitor"
        Width="320"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        MouseRightButtonUp="OnRightClick">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#B8B3A8" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="312" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="78" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="↑" Foreground="{Binding UploadBrush}" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding UploadText}" Foreground="{Binding UploadBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="↓" Foreground="{Binding DownloadBrush}" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding DownloadText}" Foreground="{Binding DownloadBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="CPU" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding CpuText}" Foreground="{Binding CpuBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="MEM" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding MemText}" Foreground="{Binding MemBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="GPU" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding GpuText}" Foreground="{Binding GpuBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowVram, Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource Label}" Text="VRAM" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding VramText}" Foreground="{Binding VramBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="CPU" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding CpuTempText}" Foreground="{Binding CpuTempBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Label}" Text="GPU" />
                <TextBlock Style="{StaticResource Value}" Text="{Binding GpuTempText}" Foreground="{Binding GpuTempBrush}" />
            </StackPanel>
        </Grid>
    </Viewbox>
</Window>
