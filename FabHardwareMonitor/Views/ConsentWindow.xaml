<views:FabWindow x:Class="FabHardwareMonitor.Views.ConsentWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:views="clr-namespace:FabHardwareMonitor.Views"
                 Style="{StaticResource FabWindow}"
                 Title="Privacy &amp; terms"
                 Width="520"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen">

    <DockPanel Margin="28,24,28,22">
        <StackPanel DockPanel.Dock="Bottom">
            <Border Style="{StaticResource Rule}" Margin="0,18,0,16" />
            <Button Content="Close"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="OnClose" />
        </StackPanel>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Source="/Assets/app-icon.png"
                       Width="44"
                       Height="44"
                       Margin="0,0,14,0"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Privacy Policy and Terms of Use"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="This is the same document shown during installation. Hardware readings stay on this PC."
                               Style="{StaticResource HintText}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    Margin="0,20,0,0"
                    Padding="0">
                <ScrollViewer MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,14">
                    <TextBlock x:Name="PolicyText"
                               FontFamily="{StaticResource SansFont}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</views:FabWindow>
