<Window x:Class="FabHardwareMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF121417"
        Foreground="#FFF4F1EA"
        FontFamily="Bahnschrift"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,14" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF4F1EA" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC8C4BB" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFC4A574" />
            <Setter Property="Foreground" Value="#FF121417" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#33C4A574" BorderThickness="0,3,0,0" Padding="24">
        <StackPanel>
            <TextBlock Text="Hardware" FontSize="16" Foreground="#FFF4F1EA" Margin="0,0,0,12" />
            <TextBlock Text="Refresh interval" />
            <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding SelectedInterval}" DisplayMemberPath="Name" />
            <TextBlock Text="Network adapter" />
            <ComboBox ItemsSource="{Binding Nics}" SelectedItem="{Binding SelectedNic}" DisplayMemberPath="Name" />
            <TextBlock Text="GPU" />
            <ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="Name" />
            <TextBlock Text="CPU temperature sensor" />
            <ComboBox ItemsSource="{Binding CpuSensors}" SelectedItem="{Binding SelectedSensor}" DisplayMemberPath="Name" />
            <TextBlock Text="Text color" />
            <ComboBox ItemsSource="{Binding TextColors}" SelectedItem="{Binding SelectedTextColor}" DisplayMemberPath="Name" />
            <CheckBox Content="Show VRAM" IsChecked="{Binding ShowVram}" />

            <TextBlock Text="App" FontSize="16" Foreground="#FFF4F1EA" Margin="0,10,0,12" />
            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Content="Automatically install updates" IsChecked="{Binding AutoUpdate}" />

            <Button Content="Install PawnIO driver"
                    Command="{Binding InstallPawnIoCommand}"
                    Visibility="{Binding ShowPawnIoInstall, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,8" />
            <TextBlock Text="{Binding PawnIoStatus}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#FFC4A574" />

            <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Click="OnSave" />
        </StackPanel>
    </Border>
</Window>
