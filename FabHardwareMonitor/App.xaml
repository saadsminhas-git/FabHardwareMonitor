<Application x:Class="FabHardwareMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FF121417" />
        <SolidColorBrush x:Key="Copper" Color="#FFC4A574" />
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FF1A1D21" />
            <Setter Property="Foreground" Value="#FFF4F1EA" />
            <Setter Property="BorderBrush" Value="#33C4A574" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF4F1EA" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Application.Resources>
</Application>
